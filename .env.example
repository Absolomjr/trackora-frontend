# Copy this file to `.env` and adjust the values for your environment.
#
# NOTE: Vite inlines every VITE_-prefixed variable into the public client
# bundle at build time. These values are visible to anyone using the app —
# never put secrets (private API keys, passwords, signing keys) here.

# Base URL of the Trackora REST API.
VITE_API_URL=http://127.0.0.1:8000/api
